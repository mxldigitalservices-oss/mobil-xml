# ============================================================
# mobil-xml / infra  -  Variables de entorno
# Copia este archivo:  cp .env.example .env
# Luego cambia TODOS los valores "change_me_*"
# ============================================================

# --- General ---
COMPOSE_PROJECT_NAME=mobil-xml
TZ=America/Santo_Domingo

# --- PostgreSQL ---
POSTGRES_USER=mobil
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=mobil_xml
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# --- MongoDB ---
MONGO_ROOT_USER=mobil_admin
MONGO_ROOT_PASSWORD=change_me_mongo
MONGO_DB=mobil_xml
MONGO_PORT=27017

# --- Ollama ---
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
# Modelo que deploy.sh descarga automaticamente (dejar vacio para omitir)
OLLAMA_MODEL=llama3.2:3b

# --- Redroid (Android emulado) ---
REDROID_IMAGE=redroid/redroid:13.0.0-latest
REDROID_WIDTH=720
REDROID_HEIGHT=1280
REDROID_DPI=320
REDROID_FPS=30
REDROID_GPU_MODE=guest
REDROID_ADB_PORT_1=5555
REDROID_ADB_PORT_2=5556
