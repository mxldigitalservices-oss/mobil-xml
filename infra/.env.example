# ============================================================
# mobil-xml / infra  -  Variables de entorno
#
# Recomendado:   ./deploy.sh init
#   (crea .env y genera automaticamente todos los valores change_me_*)
#
# Manual:  cp .env.example .env  y reemplaza cada "change_me_*" por un
#          secreto aleatorio de 16+ caracteres [A-Za-z0-9_-]
#          (ej.: openssl rand -hex 24). Evita $, comillas y espacios.
# ============================================================

# --- General ---
COMPOSE_PROJECT_NAME=mobil-xml
TZ=America/Santo_Domingo
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Imagenes (fijadas; para maxima reproducibilidad usa digests @sha256:...) ---
POSTGRES_IMAGE=postgres:16.4-alpine
REDIS_IMAGE=redis:7.4-alpine
MONGO_IMAGE=mongo:7.0.14
OLLAMA_IMAGE=ollama/ollama:0.3.12
REDROID_IMAGE=redroid/redroid:13.0.0-latest

# --- PostgreSQL (solo red interna; sin puerto en el host) ---
POSTGRES_USER=mobil
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=mobil_xml

# --- Redis (solo red interna) ---
REDIS_PASSWORD=change_me_redis
REDIS_MAXMEMORY=256mb

# --- MongoDB (solo red interna) ---
MONGO_ROOT_USER=mobil_admin
MONGO_ROOT_PASSWORD=change_me_mongo
MONGO_DB=mobil_xml

# --- Ollama (solo red interna) ---
OLLAMA_KEEP_ALIVE=5m
# Modelo que deploy.sh descarga automaticamente (dejar vacio para omitir)
OLLAMA_MODEL=llama3.2:3b

# --- Redroid (Android emulado; ADB solo en la red interna device_net) ---
REDROID_WIDTH=720
REDROID_HEIGHT=1280
REDROID_DPI=320
REDROID_FPS=30
REDROID_GPU_MODE=guest
# Dispositivos a los que el orquestador se conecta y unicos permitidos en tareas
ADB_TARGETS=redroid-1:5555,redroid-2:5555
ALLOWED_DEVICES=redroid-1:5555,redroid-2:5555
WORKERS=4

# --- API ---
# Unico puerto publicado. 127.0.0.1 = solo el host; usa un proxy inverso con TLS.
API_BIND=127.0.0.1
API_PORT=8000
# Clave del frontend (header X-API-Key). Minimo 32 caracteres.
API_KEY=change_me_api_key
# Origenes CORS separados por comas (vacio = CORS desactivado)
CORS_ORIGINS=
# Hosts permitidos separados por comas, ej: api.midominio.com (vacio = sin restriccion)
ALLOWED_HOSTS=
SEND_RATE_PER_MINUTE=30
SEND_RATE_PER_RECIPIENT_HOUR=10

# --- WhatsApp Cloud API (Meta) ---
# VERIFY_TOKEN: inventalo (se genera solo con init) y pegalo en el panel de Meta.
WHATSAPP_VERIFY_TOKEN=change_me_whatsapp_verify
# Los tres siguientes los entrega Meta; completalos a mano.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
